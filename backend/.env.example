# Copier ce fichier en .env et adapter les valeurs.
# Ne jamais commiter le fichier .env (il contiendra des secrets plus tard).
APP_NAME="Smash BDE API"
ENVIRONMENT=dev
# En local : fichier dans backend/. Sur le serveur : chemin absolu persistant.
DATABASE_URL=sqlite:///./smash.db
# Mettre true sur le serveur (HTTPS obligatoire).
COOKIE_SECURE=false

# Identifiants de l'application OAuth 42 (https://profile.intra.42.fr/oauth/applications)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1
