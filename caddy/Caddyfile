# Terminaison TLS en production : Caddy obtient et renouvelle seul le certificat
# Let's Encrypt pour $DOMAIN (défini dans le .env à la racine), puis relaie à nginx.
# Prérequis : le DNS de $DOMAIN pointe sur le VPS et les ports 80/443 sont ouverts.
# Le port 80 sert au challenge ACME et redirige automatiquement vers HTTPS.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Caddy transmet X-Forwarded-For / X-Forwarded-Proto: https ; nginx les relaie au backend
	reverse_proxy nginx:80
}
